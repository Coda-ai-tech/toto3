      "content": {
        "title": "COMFORT GLIDE",
        "icon": "/assets/img/content/technology/comfort-glide/ico-comfort-glide.png",
        "items": [
          {
            "align": "row",
            "context": "COMFORT GLIDE technology makes it possible to use the faucet easily and without resistance for many years to come. All TOTO faucets with a lever come equipped with this unique technology.<br/><br/><b>Ease of Use</b><br/><br/>As faucets get older, the lever that controls the flow of water no longer moves smoothly and without resistance. As a result, it becomes more difficult  to regulate the flow of water freely. TOTO coats the ceramic disk – one of the most important parts of the valve – with DLC (diamond-like carbon) instead of simply lubricating it like conventional faucets. This extends the longevity and ease of use of the faucet.",
            "images": ["/assets/img/content/technology/comfort-glide/COMFORT_GLIDE.jpg"]
          }
        ],
        "youtube": "JiHcsgPDpUs?si=u5ibgEC1US-cZnSa"
      }
