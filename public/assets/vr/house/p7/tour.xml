	<!-- startup action - load the first scene -->
	<action name="startup" autorun="onstart">
		if(startscene === null OR !scene[get(startscene)], copy(startscene,scene[0].name); );
		loadscene(get(startscene), null, MERGE);
		if(startactions !== null, startactions() );
	</action>

	<layer name="opt_select"
	    type="container"
	    keep="true"
	    now="def"
	    align="bottom"
	    width="100%"
	    height="40"
	>
	</layer>

	<action name="skin_hotspotstyle_click" scope="local">
		if(isvalue(caller.linkedscene),
		if(layer[opt_select].now == opt AND isvalue(caller.linkedscene_opt),
		    copy(hs_linkedscene, caller.linkedscene_opt);
		,
		    if(layer[opt_select].now == opt2 AND isvalue(caller.linkedscene_opt2),
			copy(hs_linkedscene, caller.linkedscene_opt2);
		    ,
			copy(hs_linkedscene, caller.linkedscene);
		    );
		);

			if(caller.linkedscene_lookat, txtsplit(caller.linkedscene_lookat, ',', hs_lookat_h, hs_lookat_v, hs_lookat_fov); );
			set(caller.enabled, false);
			skin_hidetooltips();

				skin_loadscene(get(hs_linkedscene), get(skin_settings.loadscene_blend));
				if(hs_lookat_h !== null, skin_lookat(get(hs_lookat_h), get(hs_lookat_v), get(hs_lookat_fov)); );
				skin_updatescroll();

		);
	</action>

	<action name="set_opt2">
	    set(layer[opt_select].now,opt2);
	</action>

	<style name="selectstyle_opt2" type="text" align="center" edge="left"
		   alpha="0"  scale="0.4" zoom="true"
		   autoalpha="true"
		   onclick="if(layer[opt_select].now != opt2,
				set_opt2();

				if(isvalue(scene[get(xml.scene)].opt2scene),
				    set(layer[opt_select].optchange,true);
				    skin_loadscene(get(scene[get(xml.scene)].opt2scene), get(skin_settings.loadscene_blend), MERGE|KEEPVIEW));
				);
			    )" />


